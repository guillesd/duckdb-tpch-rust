# name: test/sql/rusty_tpch.test
# description: test the rusty_tpch extension (parquet generation + DuckDB-table generation)
# group: [tpch]

# Before the extension is loaded, the functions do not exist.
statement error
CALL tpch_gen(0.1, 'tmp/dir');
----
Catalog Error

# Load the extension for the rest of the file.
require rusty_tpch

# ---------------------------------------------------------------------------
# Parquet path: tpch_gen writes files. The `tables` named parameter is optional
# (absent = all tables); a subset is selected with `tables := [...]`.
# ---------------------------------------------------------------------------
query I
CALL tpch_gen(0.01, 'tmp/dir_all');
----
Successfully generated TPC-H data

query I
CALL tpch_gen(0.01, 'tmp/dir', tables := ['lineitem', 'orders']);
----
Successfully generated TPC-H data

# ---------------------------------------------------------------------------
# DuckDB path: tpch(sf, 'table') emits rows; CREATE TABLE AS materializes them.
# ---------------------------------------------------------------------------
statement ok
CREATE TABLE lineitem AS FROM tpch(0.01, 'lineitem');

# Known SF=0.01 row counts.
query I
SELECT count(*) FROM lineitem;
----
60175

query I
SELECT count(*) FROM tpch(0.01, 'orders');
----
15000

query I
SELECT count(*) FROM tpch(0.01, 'nation');
----
25

query I
SELECT count(*) FROM tpch(0.01, 'region');
----
5

# Decimal, date and string mapping: the first lineitem row matches the TPC-H spec values.
query TTTTT
SELECT l_quantity, l_extendedprice, l_discount, l_shipdate, l_returnflag
FROM lineitem ORDER BY l_orderkey, l_linenumber LIMIT 1;
----
17.00	24710.35	0.04	1996-03-13	N

# Aggregates match the canonical generator (sanity vs official dbgen at SF=0.01).
query II
SELECT sum(l_quantity)::HUGEINT, round(sum(l_extendedprice * (1 - l_discount)), 2) FROM lineitem;
----
1536127	2045134942.09

# An unknown table name is rejected at bind time.
statement error
SELECT * FROM tpch(1, 'not_a_table');
----
unknown TPC-H table

# ---------------------------------------------------------------------------
# Helper: tpch_load returns one CREATE TABLE AS statement per table.
# ---------------------------------------------------------------------------
# One settings row + one CREATE TABLE AS per table.
query I
SELECT count(*) FROM tpch_load(1);
----
9

query T
SELECT statement FROM tpch_load(1) WHERE table_name = 'lineitem';
----
CREATE TABLE lineitem AS FROM tpch(1, 'lineitem');

query T
SELECT statement FROM tpch_load(1) WHERE table_name = '(settings)';
----
SET preserve_insertion_order = false;

# The optional `tables` parameter restricts the script (settings row + 2 tables = 3 rows).
query I
SELECT count(*) FROM tpch_load(1, tables := ['lineitem', 'orders']);
----
3
